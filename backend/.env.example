# Database
# Example Neon PostgreSQL URL: postgres://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mentorlink

# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_GROUP_ID=-1001234567890
# Use polling locally; use webhook on Render or another multi-instance host.
BOT_MODE=polling
# Required when BOT_MODE=webhook. WEBHOOK_URL must include the full API path.
WEBHOOK_URL=https://your-backend.onrender.com/telegram/webhook/replace-with-secret
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional: Telegram Forum Topic IDs (Leave empty if group has no topics enabled)
PARENT_REQUESTS_TOPIC_ID=
TUTOR_REGISTRATION_TOPIC_ID=

# Super Admin Telegram User ID (numeric ID for private admin console)
SUPER_ADMIN_ID=123456789
# Optional legacy fallback. Prefer /start -> Manage Admins in the Super Admin console.
ADMIN_IDS=

# WebApp URLs:
# WEBAPP_URL: HTTPS origin of the deployed frontend (Vercel or Render). Used for the public
#             Mini App button AND as the origin browsers are allowed to call this API from
#             (CORS). Scheme + host only: no path, no trailing slash.
WEBAPP_URL=https://your-frontend-deployment.vercel.app
# MINI_APP_URL: the BotFather *direct link* of the ADMIN Mini App (created with /newapp),
#               e.g. https://t.me/MentorLinkBot/admin. "Review in App" buttons on admin cards
#               are built from it. It must be the t.me link, NOT the Vercel URL.
MINI_APP_URL=https://t.me/MentorLinkBot/admin
# Optional, no default. Only used to build https://t.me/<bot username>/<this> when MINI_APP_URL
# is not a t.me link. It must be the short name you chose in BotFather /newapp for the admin app;
# a name that isn't registered makes "Review in App" open the bot chat instead of the app.
ADMIN_MINI_APP_SHORT_NAME=
# direct | bot | both (default). "both" adds an "Open via bot" button that always opens the app.
ADMIN_REVIEW_LINK_MODE=both
# Optional: comma-separated extra origins allowed by CORS, e.g. when the admin Mini App is
# hosted on a different domain than WEBAPP_URL.
CORS_EXTRA_ORIGINS=

# Secret for POST /api/v1/admin/cron/run (the scheduled GitHub Actions workflow sends it as
# X-Cron-Secret). There is deliberately no default: generate a long random value and set the
# SAME value as the CRON_SECRET secret in GitHub. Leave empty to disable secret-based access.
CRON_SECRET=

# Environment
ENVIRONMENT=development

# Set to 'true' ONLY during local development/testing without Telegram Mini App container
# In production, leave 'false' (or omit) to require valid Telegram initData HMAC signatures
ALLOW_UNVERIFIED_WEB_PREVIEW=false
